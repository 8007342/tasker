// Cloudflare settings for Tasker. Pushing main runs: npm run build, then npx wrangler deploy.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tasker",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-05",
  "routes": [{ "pattern": "tasker.tlatoani.net", "custom_domain": true }],
  "assets": {
    "directory": "./build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // No database_id on purpose: wrangler creates the D1 database on the first deploy
  // and later deploys keep using it.
  "d1_databases": [{ "binding": "DB", "database_name": "tasker" }]
}
